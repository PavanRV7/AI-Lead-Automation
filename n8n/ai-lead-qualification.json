    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an AI B2B Sales Lead Qualification Assistant.\n\nAnalyze the following lead and evaluate its business potential.\n\nLead Information:\nName: {{$json.name}}\nEmail: {{$json.email}}\nCompany: {{$json.company}}\nIndustry: {{$json.industry}}\nCompany Size: {{$json.company_size}}\nMessage: {{$json.message}}\n\nEvaluate the lead based on:\n- Business need and pain point\n- Purchase intent\n- Company size\n- Urgency\n- Potential value of the opportunity\n\nReturn ONLY valid JSON in this exact structure:\n\n{\n  \"lead_score\": 0,\n  \"priority\": \"High\",\n  \"purchase_intent\": \"High\",\n  \"pain_points\": \"Main business pain points\",\n  \"recommended_action\": \"Recommended next action\",\n  \"ai_summary\": \"Short summary of the lead\"\n}\n\nRules:\n- lead_score must be an integer from 0 to 100.\n- priority must be exactly High, Medium, or Low.\n- purchase_intent must be exactly High, Medium, or Low.\n- Do not include markdown or ``` in the response.",
        "hasOutputParser": true,
        "batching": {}
      },
